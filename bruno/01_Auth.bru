meta {
  name: 01_Auth
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "admin",
    "password": "password123"
  }
}

tests {
  test("Status code é 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Deve gerar token de autenticação", function() {
    const data = res.getBody();
    expect(data).to.have.property('token');
    bru.setVar("authToken", data.token);
  });
}
